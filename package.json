{
  "name": "ccdesk",
  "version": "0.0.1",
  "description": "A small local UI for Claude Code and Codex — browse past conversations and continue them in one place.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "ccdesk": "./bin/ccdesk.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "server.js",
    "bin/",
    "lib/",
    "public/",
    "README.md",
    "DESIGN.md",
    "SPEC.md",
    "spec/",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "ui",
    "cli"
  ],
  "scripts": {
    "start": "node bin/ccdesk.js",
    "doctor": "node bin/ccdesk.js doctor",
    "test": "node test/provider-contract.test.js && node test/normalize.test.js",
    "pack:local": "npm pack",
    "prepack": "npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZerochordAI/ccdesk.git"
  },
  "bugs": {
    "url": "https://github.com/ZerochordAI/ccdesk/issues"
  },
  "homepage": "https://github.com/ZerochordAI/ccdesk#readme",
  "author": "Zerochord AI"
}
